# Version control
.git
.gitignore
.gitattributes

# Frontend build artifacts & dependencies (prevent sending heavy files)
frontend/node_modules
frontend/dist
frontend/*.7z
frontend/.env
frontend/.env.*
!frontend/.env.example


# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs & local generated files
dist
build
generated

# Environment & secrets
.env
.env.*
!.env.example

# Tests & coverage
test
test/
*.spec.ts
*.test.ts
coverage
.nyc_output

