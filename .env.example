NODE_ENV=development

SERVER_HOST=
SERVER_PORT=

# Prisma Database URL
DB_NAME=inspect
DB_USER=postgres
DB_PASSWORD=secret
DB_HOST=localhost
DB_PORT=5432

DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

JWT_SECRET=
JWT_EXPIRES_IN=
JWT_COOKIE_EXPIRES_IN=

# Refresh Tokens
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=

# CORS (comma-separated allowed origins, required for cookie auth from browser)
CORS_ORIGIN=http://localhost:5173

# S3 Bucket
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

#Cloude Flare
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=