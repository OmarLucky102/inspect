# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and customize for your local or production environment.
# Never commit real credentials, passwords, or production secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
FRONTEND_PORT=80
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Frontend Build-Time Configuration (Vite)
# ------------------------------------------------------------------------------
VITE_API_URL=/api/v1

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database & Prisma ORM Configuration
# ------------------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=postgres_secure_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inspect
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# ------------------------------------------------------------------------------
# 4. Authentication & JWT Tokens
# ------------------------------------------------------------------------------
# Generate strong, random secrets in production (e.g. openssl rand -base64 32)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_secure_random_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=15d
REFRESH_TOKEN_GRACE_PERIOD_SECONDS=20s

# ------------------------------------------------------------------------------
# 5. S3 / SeaweedFS Object Storage
# ------------------------------------------------------------------------------
# Local dev outside Docker: http://localhost:8333
# Inside Docker stack: http://seaweedfs:8333
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=inspect-bucket
S3_ACCESS_KEY=replace_with_alphanumeric_s3_access_key
S3_SECRET_KEY=replace_with_alphanumeric_s3_secret_key

# ------------------------------------------------------------------------------
# 6. Cloudflare R2 Storage (Optional Alternative Provider)
# ------------------------------------------------------------------------------
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=
VITE_CDN_URL=https://pub-xxxxxx.r2.dev

# ------------------------------------------------------------------------------
# 7. Database Seeding (Super Admin User)
# ------------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=change_this_super_admin_password_123!
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
SUPER_ADMIN_PHONE=+1234567890
