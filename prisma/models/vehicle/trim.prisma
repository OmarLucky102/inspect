model VehicleTrim {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  name     String
  nameAr   String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles             Vehicle[]
  originalTrimRequests InspectionRequest[] @relation("OriginalTrimRequests")

  @@map("vehicle_trims")
}
