model PasswordResetToken {
    id        String    @id @default(uuid()) @db.Uuid
    userId    String    @db.Uuid
    tokenHash String    @unique
    expiresAt DateTime
    usedAt    DateTime?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@map("password_reset_tokens")
}
