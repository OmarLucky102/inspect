model InspectionPhotoChecklist {
  id                  String   @id @default(uuid()) @db.Uuid
  inspectionRequestId String   @unique @db.Uuid

  licensePhoto        Boolean  @default(true)
  airbagPhoto         Boolean  @default(true)
  roofPhoto           Boolean  @default(true)
  odometerPhoto       Boolean  @default(true)
  chassisPhoto        Boolean  @default(true)

  customFields        Json     @default("[]")

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  inspectionRequest   InspectionRequest @relation(fields: [inspectionRequestId], references: [id], onDelete: Cascade)

  @@map("inspection_photo_checklists")
}
